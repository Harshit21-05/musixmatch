# ------------------------------------------------------------------------------
# Song Radar - Environment Variables Configuration Template
# ------------------------------------------------------------------------------

# Passcode entered by human users to unlock administrative actions (tasks, manual feedback, settings)
SONG_RADAR_PASSCODE=songradar2026

# High-entropy secret strictly for HMAC-SHA256 signing of the 30-day session auth cookie
# Changing/rotating this secret immediately invalidates all active client sessions.
AUTH_SECRET=generate-a-secure-random-32-character-secret-for-production

# Secret Bearer token used by external automation scouts pushing song events to POST /api/ingest
INGEST_TOKEN=songradar-secret-ingest-token-2026

# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Shared Distributed Rate Limiting (Upstash Redis)
# If omitted, Song Radar automatically falls back to PostgreSQL-backed rate limiting.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional: Direct Postgres connection string (for smoke test deep catalog inspection)
DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
